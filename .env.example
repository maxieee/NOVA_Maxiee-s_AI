# NOVA environment configuration
#
# By default NOVA runs on a local SQLite data layer (see lib/db/local.ts),
# seeded with demo data, so the app works with zero configuration.
#
# To switch to a real Supabase/Postgres backend:
#   1. Create a project at https://supabase.com
#   2. Run the SQL migrations in database/migrations/ against it
#      (e.g. via the Supabase SQL editor or `supabase db push`)
#   3. Fill in the values below
#   4. Set NOVA_DATA_SOURCE=supabase and DATABASE_URL (see below)
#
# NOVA_DATA_SOURCE: "local" (default, SQLite) or "supabase"
NOVA_DATA_SOURCE=local

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for client use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SERVER-ONLY — bypasses row-level security,
# NEVER expose to the client / never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (SERVER-ONLY) — required when
# NOVA_DATA_SOURCE=supabase. lib/db/supabase.ts connects via the raw
# Postgres wire protocol (the `pg` package), not the supabase-js query
# builder, so it needs a real connection string rather than the
# URL/anon-key pair above. In the Supabase dashboard: Project Settings ->
# Database -> Connection string (use the "Session pooler" or "Transaction
# pooler" URI for serverless). Get this from your Supabase project or any
# other Postgres instance; SUPABASE_DB_URL is accepted as an alias.
DATABASE_URL=
# SUPABASE_DB_URL=

# Optional: max connections in the pooled Postgres client (default 5,
# appropriate for a single-user serverless deployment)
NOVA_PG_POOL_MAX=5

# Optional: set to "false" to disable TLS for a local/self-signed Postgres
# during development. Leave unset (or "true") for Supabase/production.
NOVA_PG_SSL=true

# Optional: path to local sqlite file (defaults to database/nova.sqlite)
NOVA_SQLITE_PATH=database/nova.sqlite

# Twilio credentials for the phone-call (and SMS) notification provider
# (lib/notifications/providers/twilio.ts). All three must be set for real
# calls/SMS to be attempted — otherwise NOVA reports "not configured"
# rather than pretending to have delivered anything.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The number NOVA calls/texts on escalation (your own phone, in E.164
# format, e.g. +919876543210) is NOT an env var — it's set per-user in
# Settings > Phone Calls (stored in user_preferences.phone_number). It is
# deliberately separate from any "Call" reminder's contact info.

# Web Push (VAPID) — required for real push notifications.
# Generate a keypair with: npm run vapid:generate
# All three of VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT must be set
# for push to actually send; otherwise NOVA reports "not configured".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https URL identifying you to push services.
VAPID_SUBJECT=mailto:you@example.com

# Same value as VAPID_PUBLIC_KEY, exposed to the browser so it can create a
# PushSubscription. Never put the private key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Calendar OAuth2 (V11 Integrations) — OPTIONAL. Without these three
# set, NOVA honestly shows Google Calendar as "not connected" and the
# connect button is disabled; it never fakes a connection. Requires a real
# Google Cloud project with the Calendar API enabled and an OAuth2 client
# (type: Web application). See https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured on that OAuth
# client, e.g. http://localhost:3000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Shared secret required by POST /api/cron/process-due-reminders. Set this
# in production and configure your scheduler (e.g. Vercel Cron) to send it
# as `Authorization: Bearer <value>`; local/manual calls use the
# `x-cron-secret` header instead. Leave unset only for local dev if you
# don't mind the route being unauthenticated.
CRON_SECRET=

# Shared secret protecting ALL /api/* routes except the cron endpoint above
# (which uses CRON_SECRET instead) and the Google OAuth callback (which
# can't carry it — see README "Authentication"). SERVER-ONLY, never expose
# to the client / never prefix with NEXT_PUBLIC_. Checked by middleware.ts
# via a timing-safe comparison. The browser proves it knows this token once,
# at /login, which trades it for an httpOnly session cookie
# (POST /api/auth/login) — after that every same-origin fetch (including
# the service worker's notification-action calls) carries the cookie
# automatically, so no client code stores or attaches the raw token.
# Generate a strong random value with: openssl rand -hex 32
# Required in any deployment reachable over the network; leave unset only
# for local dev if you don't mind every /api/* route being unauthenticated.
APP_ACCESS_TOKEN=

# Optional follow-up/escalation timing overrides (see
# lib/notifications/followUpConfig.ts). All are optional; every default is
# the production value used when unset. NOVA_FOLLOWUP_MINUTES_<INTENSITY>
# sets the interval between repeat notifications for that intensity
# (gentle/normal/persistent/critical); the matching *_SECONDS variant
# overrides it in seconds instead, which is only meant for fast local
# testing (e.g. NOVA_FOLLOWUP_SECONDS_NORMAL=5). NOVA_ESCALATE_AFTER_<INTENSITY>
# sets how many unacknowledged repeats happen before escalating to the next
# channel (gentle never escalates). NOVA_MAX_FOLLOWUP_ATTEMPTS is a hard
# ceiling on repeat attempts for any intensity.
# NOVA_FOLLOWUP_MINUTES_GENTLE=
# NOVA_FOLLOWUP_SECONDS_GENTLE=
# NOVA_FOLLOWUP_MINUTES_NORMAL=
# NOVA_FOLLOWUP_SECONDS_NORMAL=
# NOVA_FOLLOWUP_MINUTES_PERSISTENT=
# NOVA_FOLLOWUP_SECONDS_PERSISTENT=
# NOVA_FOLLOWUP_MINUTES_CRITICAL=
# NOVA_FOLLOWUP_SECONDS_CRITICAL=
# NOVA_ESCALATE_AFTER_NORMAL=
# NOVA_ESCALATE_AFTER_PERSISTENT=
# NOVA_ESCALATE_AFTER_CRITICAL=
# NOVA_MAX_FOLLOWUP_ATTEMPTS=
