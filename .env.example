# NOVA environment configuration
#
# By default NOVA runs on a local SQLite data layer (see lib/db/local.ts),
# seeded with demo data, so the app works with zero configuration.
#
# To switch to a real Supabase/Postgres backend:
#   1. Create a project at https://supabase.com
#   2. Run the SQL migrations in database/migrations/ against it
#      (e.g. via the Supabase SQL editor or `supabase db push`)
#   3. Fill in the values below
#   4. Set DATA_SOURCE=supabase
#
# NOVA_DATA_SOURCE: "local" (default, SQLite) or "supabase"
NOVA_DATA_SOURCE=local

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for client use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-only, NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: path to local sqlite file (defaults to database/nova.sqlite)
NOVA_SQLITE_PATH=database/nova.sqlite

# Twilio credentials for the phone-call (and SMS) notification provider
# (lib/notifications/providers/twilio.ts). All three must be set for real
# calls/SMS to be attempted — otherwise NOVA reports "not configured"
# rather than pretending to have delivered anything.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The number NOVA calls/texts on escalation (your own phone, in E.164
# format, e.g. +919876543210) is NOT an env var — it's set per-user in
# Settings > Phone Calls (stored in user_preferences.phone_number). It is
# deliberately separate from any "Call" reminder's contact info.

# Web Push (VAPID) — required for real push notifications.
# Generate a keypair with: npm run vapid:generate
# All three of VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT must be set
# for push to actually send; otherwise NOVA reports "not configured".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: address or https URL identifying you to push services.
VAPID_SUBJECT=mailto:you@example.com

# Same value as VAPID_PUBLIC_KEY, exposed to the browser so it can create a
# PushSubscription. Never put the private key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Google Calendar OAuth2 (V11 Integrations) — OPTIONAL. Without these three
# set, NOVA honestly shows Google Calendar as "not connected" and the
# connect button is disabled; it never fakes a connection. Requires a real
# Google Cloud project with the Calendar API enabled and an OAuth2 client
# (type: Web application). See https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" configured on that OAuth
# client, e.g. http://localhost:3000/api/integrations/google/callback
GOOGLE_REDIRECT_URI=

# Shared secret required by POST /api/cron/process-due-reminders. Set this
# in production and configure your scheduler (e.g. Vercel Cron) to send it
# as `Authorization: Bearer <value>`; local/manual calls use the
# `x-cron-secret` header instead. Leave unset only for local dev if you
# don't mind the route being unauthenticated.
CRON_SECRET=
